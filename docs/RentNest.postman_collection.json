          "name": "Create Stripe checkout session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.success) {",
                  "  if (json.data.paymentId !== undefined) pm.collectionVariables.set(\"paymentId\", json.data.paymentId);",
                  "  if (json.data.sessionId !== undefined) pm.collectionVariables.set(\"sessionId\", json.data.sessionId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
