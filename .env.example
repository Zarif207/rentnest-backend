# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- Database (PostgreSQL, e.g. Neon) ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ---------- Auth ----------
# Use a long random string, e.g. `openssl rand -base64 48`
# At least 32 random characters, or the server refuses to start.
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-or-more-characters
JWT_ACCESS_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- Stripe (test mode) ----------
STRIPE_SECRET=sk_test_xxx
# Signing secret of the webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Where Stripe Checkout redirects after payment.
# session_id={CHECKOUT_SESSION_ID} is appended to the success URL automatically.
CLIENT_SUCCESS_URL=http://localhost:3000/payment/success
CLIENT_CANCEL_URL=http://localhost:3000/payment/cancel

# ---------- Geocoding (optional) ----------
# Contact email sent to OpenStreetMap Nominatim, as its usage policy asks.
GEOCODER_EMAIL=you@example.com

# ---------- CORS ----------
# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# ---------- Seed and account scripts ----------
# The seed creates the admin only if it doesn't exist, with ADMIN_PASSWORD.
# `npm run admin:set-password` changes that admin's password (12+ characters,
# with a letter, a digit and a symbol).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password>
# The seed refuses non-local databases and NODE_ENV=production unless this is true.
ALLOW_PROD_SEED=false

# `npm run observer:create`: a read-only OBSERVER account.
OBSERVER_EMAIL=observer@rentnest.dev
OBSERVER_PASSWORD=<choose-a-strong-password>
