# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- Database (PostgreSQL, e.g. Neon) ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ---------- Auth ----------
# Use a long random string, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- Stripe (test mode) ----------
STRIPE_SECRET=sk_test_xxx
# Signing secret of the webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Where Stripe Checkout redirects after payment.
# session_id={CHECKOUT_SESSION_ID} is appended to the success URL automatically.
CLIENT_SUCCESS_URL=http://localhost:3000/payment/success
CLIENT_CANCEL_URL=http://localhost:3000/payment/cancel

# ---------- Geocoding (optional) ----------
# Contact email sent to OpenStreetMap Nominatim, as its usage policy asks.
GEOCODER_EMAIL=you@example.com

# ---------- Seed (optional) ----------
# Defaults: admin@rentnest.com / Admin@123
SEED_ADMIN_EMAIL=admin@rentnest.com
SEED_ADMIN_PASSWORD=Admin@123
