model Property {
  id          String @id @default(uuid())
  title       String
  description String
  address     String
  city        String
  division    String

  // Map pin; geocoded from the address when not sent. null if geocoding failed.
  latitude  Float?
  longitude Float?

  // RENT listings have rentAmount (monthly); SALE listings have salePrice and no rent.
  listingType ListingType @default(RENT)
  rentAmount  Decimal?
  salePrice   Decimal?
  bedrooms    Int
  bathrooms   Int
  area        Int

  propertyType       PropertyType
  availabilityStatus AvailabilityStatus @default(AVAILABLE)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  amenities String[]
  images    Json

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
  offers    PurchaseOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([propertyType])
  @@index([rentAmount])
  @@index([ownerId])
  @@index([listingType])
}
