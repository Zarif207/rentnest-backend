model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  phone          String?
  role           UserRole
  userStatus     UserStatus      @default(ACTIVE)
  // null for tenants and admins; landlords start PENDING
  landlordStatus LandlordStatus?
  properties     Property[]
  bookings       Booking[]
  reviews        Review[]
  notifications  Notification[]
  favorites      Favorite[]
  offers         PurchaseOffer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
