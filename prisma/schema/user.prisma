model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  password   String
  phone      String?
  role       UserRole
  userStatus UserStatus  @default(ACTIVE)
  properties Property[]
  bookings   Booking[]
  reviews    Review[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}