enum UserRole {
  ADMIN
  LANDLORD
  TENANT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

// Only landlords have one: PENDING until an admin approves or rejects them.
enum LandlordStatus {
  PENDING
  APPROVED
  REJECTED
}

// New listings start PENDING and are public only once an admin APPROVES
// them. A REJECTED listing goes back to PENDING when its landlord edits it.
enum PropertyReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  VILLA
}

// RENT homes go AVAILABLE -> RENTED; SALE homes AVAILABLE -> UNDER_CONTRACT -> SOLD.
enum AvailabilityStatus {
  AVAILABLE
  RENTED
  UNDER_CONTRACT
  SOLD
}

enum ListingType {
  RENT
  SALE
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum PaymentMethod {
  CARD
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationType {
  LANDLORD_REGISTERED
  LANDLORD_APPROVED
  LANDLORD_REJECTED
  RENTAL_REQUESTED
  RENTAL_APPROVED
  RENTAL_REJECTED
  PAYMENT_RECEIVED
  PAYMENT_SUCCESS
  RENTAL_COMPLETED
  REVIEW_RECEIVED
  ACCOUNT_BLOCKED
  ACCOUNT_UNBLOCKED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_COUNTERED
  OFFER_WITHDRAWN
  DEPOSIT_RECEIVED
  DEPOSIT_PAID
  SALE_COMPLETED
  PROPERTY_SUBMITTED
  PROPERTY_APPROVED
  PROPERTY_REJECTED
}

// PENDING -> (owner) COUNTERED | ACCEPTED | REJECTED; COUNTERED -> (buyer)
// ACCEPTED; ACCEPTED -> (deposit) DEPOSIT_PAID -> (owner) COMPLETED. Open
// offers can be WITHDRAWN by the buyer, and EXPIRE after 7 quiet days.
enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  DEPOSIT_PAID
  COMPLETED
  EXPIRED
}

enum OfferFinancing {
  CASH
  MORTGAGE
  OTHER
}
