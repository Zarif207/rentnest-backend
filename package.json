{
  "name": "rentnest-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RentNest: rental property marketplace REST API with role-based access and Stripe payments",
  "keywords": [
    "rental",
    "property",
    "marketplace",
    "rest-api",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "stripe",
    "jwt",
    "vercel"
  ],
  "homepage": "https://rentnest-backend-one.vercel.app",
  "bugs": {
    "url": "https://github.com/Zarif207/rentnest-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zarif207/rentnest-backend.git"
  },
  "license": "MIT",
  "author": "Zarif Hasan (https://github.com/Zarif207)",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src api prisma",
    "lint:fix": "oxlint --fix src api prisma",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/node": "^26.6.5",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "stripe": "^22.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
